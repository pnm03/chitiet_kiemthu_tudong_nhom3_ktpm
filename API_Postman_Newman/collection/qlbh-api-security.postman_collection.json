                     "name":  "API_006 - Login as admin",
                     "event":  {
                                   "script":  {
                                                  "exec":  [
                                                               "pm.test(\u0027Status code is 200\u0027, function () {",
                                                               "  pm.response.to.have.status(200);",
                                                               "});",
                                                               "",
                                                               "pm.test(\u0027Response is JSON\u0027, function () {",
                                                               "  pm.response.to.be.json;",
                                                               "});",
                                                               "",
                                                               "const json = pm.response.json();",
                                                               "pm.environment.set(\u0027admin_access_token\u0027, json.access_token || \u0027\u0027);",
                                                               "",
                                                               "pm.test(\u0027Access token is returned\u0027, function () {",
                                                               "  pm.expect(json.access_token).to.be.a(\u0027string\u0027).and.not.empty;",
                                                               "});",
                                                               "",
                                                               "pm.test(\u0027Logged in with expected email\u0027, function () {",
                                                               "  pm.expect(json.user.email).to.eql(pm.environment.get(\u0027admin_email\u0027));",
                                                               "});"
                                                           ],
                                                  "type":  "text/javascript"
                                              },
                                   "listen":  "test"
                               }
