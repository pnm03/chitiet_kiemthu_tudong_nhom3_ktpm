{
  "info": {
    "_postman_id": "2f7c0fd3-3b8d-4f1b-9b4e-api-security-qlbh",
    "name": "QLBH API Security - Unauthorized Access",
    "description": "Bộ kiểm thử tự động API bằng Postman/Newman cho các API nội bộ của hệ thống quản lý bán hàng. Bộ kiểm thử tập trung kiểm tra việc API từ chối request khi chưa có session đăng nhập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API_001 - GET categories without session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "  pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Response indicates unauthorized access', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('Unauthorized');",
              "  pm.expect(json.code).to.eql('AUTH_REQUIRED');",
              "  pm.expect(json.path).to.eql('/api/categories');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
